# Copy this file to .env.store; it is ignored by Git and loaded by store commands.
# Publisher ID: Developer Dashboard > Publisher > Settings.
# Extension ID: the existing Chrome Web Store item's ID.
CWS_PUBLISHER_ID=
CWS_EXTENSION_ID=

# OAuth credentials authorized by the account that owns this store item.
# Scope: https://www.googleapis.com/auth/chromewebstore
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=

# Alternative: export a short-lived access token (e.g. for a linked service account).
# When set, this takes precedence over OAuth refresh credentials.
CWS_ACCESS_TOKEN=
